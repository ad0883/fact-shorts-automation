# Copy to .env; the application loads it automatically. Never commit real keys.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.8-flash

# Optional stock photography. NASA and Wikimedia Commons need no API key.
PEXELS_API_KEY=
VISUAL_LAYOUT=story

# Narration and transcription
TTS_PROVIDER=gemini
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Achird
# Optional delivery override; otherwise uses warm conversational storytelling.
# TTS_STYLE=Warm, curious, conversational, with connected phrasing and brief pauses.
TTS_FALLBACK_PROVIDER=none
# Optional Edge provider settings:
TTS_VOICE=en-US-AndrewNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz
WHISPER_MODEL_SIZE=base

# Relative paths are resolved from the project root.
GAMEPLAY_DIR=assets/gameplay
OUTPUT_DIR=output
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
CAPTION_FONT=Arial Black
# CAPTION_FONT_SIZE=90

# Optional YouTube integration: install requirements-youtube.txt first.
# Set true after connecting your channel. --no-upload keeps a run local.
AUTO_UPLOAD_YOUTUBE=false
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
YOUTUBE_CHANNEL_FILE=youtube_channel.json
YOUTUBE_LANGUAGE=en
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=27

# Snapchat Spotlight (requires Public Profile API allowlisting)
AUTO_UPLOAD_SNAPCHAT=false
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_PROFILE_ID=
SNAPCHAT_REDIRECT_URI=http://localhost:8765/callback
SNAPCHAT_TOKEN_FILE=snapchat_token.json
SNAPCHAT_LOCALE=en_US
# Confirm cross-platform usage rights and required on-screen attribution first.
SNAPCHAT_RIGHTS_REVIEWED=false

# Instagram Reels: Creator/Business account, Instagram Login token, media hosting.
AUTO_UPLOAD_INSTAGRAM=false
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Set the supported Graph API version selected in your Meta app dashboard (vNN.0).
INSTAGRAM_API_VERSION=
# Public HTTPS directory mirroring output/<run>/instagram_reel.mp4; not auto-uploaded.
INSTAGRAM_MEDIA_BASE_URL=

# Facebook Page Reels (local video upload; no media hosting required).
AUTO_UPLOAD_FACEBOOK=false
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
META_API_VERSION=v26.0
# instagram: existing Instagram Login token; facebook: use Page token and Meta version.
INSTAGRAM_LOGIN_MODE=instagram
